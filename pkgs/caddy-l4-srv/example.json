{
  "admin": { "disabled": true },
  "apps": {
    "layer4": {
      "servers": {
        "loki": {
          "listen": ["unix//run/realm-discovery/loki.sock|0660"],
          "routes": [{
            "handle": [{
              "handler": "srv_proxy",
              "name": "loki.svc.mesh.nyaw.xyz",
              "resolver": "127.0.0.1:8600",
              "refresh": "5s",
              "dial_timeout": "5s"
            }]
          }]
        },
        "smtp": {
          "listen": ["unix//run/realm-discovery/smtp.sock|0660"],
          "routes": [{
            "handle": [{
              "handler": "srv_proxy",
              "name": "smtp-submission.svc.mesh.nyaw.xyz",
              "resolver": "127.0.0.1:8600"
            }]
          }]
        }
      }
    }
  }
}
