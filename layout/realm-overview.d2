direction: down
vars: { d2-config: { theme-id: 0 } }
classes: {
  node: { style: { fill: "#eef4ff"; stroke: "#37628b"; border-radius: 10; font-size: 20 } }
  gateway: { style: { fill: "#e6f4ed"; stroke: "#31765b"; border-radius: 10; font-size: 20 } }
  note: { style: { fill: "#fff6df"; stroke: "#aa8330"; border-radius: 8; font-size: 18 } }
  namespace: { style: { fill: "#f7f9fc"; stroke: "#71839b"; stroke-dash: 5; border-radius: 12; font-size: 22 } }
}
title: "Realm: Namespaces, Groups and Connections" { shape: text; style.font-size: 30 }
users: "Public and internal users" { class: node }

app_ns: "Workload A: private network namespace (ns)\nHeld by realm-net-<app>.service / Loopback only" {
  class: namespace
  app: "Application\nUser: <app user> / Group: <app group>\nNo SPIRE socket access" { class: node }
  adapter: "Optional local TCP adapter\n127.0.0.1:<localPort>\nUser: realm-<app> / Extra group: <app group>" { class: gateway }
  app -> adapter: "Loopback TCP"
}

host_ns: "Host network namespaces (one per host)\nProxies use host networking / Workloads keep separate ns" {
  class: namespace
  caddy: "Caddy HTTPS entry\nNormal HTTPS certificates" { class: gateway }
  egress: "Unix egress socket\nOwner: realm-<app> / Group: <app group>\nSocket: 0660 / Directory: 0750" { class: node }
  clients: "Realm clients: Ghostunnel\nUser / Group: realm-<app>\nExtra group: realm-proxies" { class: gateway }
  receivers: "Realm receivers: Ghostunnel\nUser / Group: realm-<backend> (default)\nExtra groups: realm-proxies + ingressGroups\nChecks caller SPIFFE allowlist" { class: gateway }
  ingress: "Unix ingress socket for TCP backend\nOwner / Group: realm-<backend>\nSocket: 0660 / Directory: 0750" { class: node }
  native: "Gateways with their own mutual TLS\nObservability Caddy / Internet Envoy\nExtra group: realm-proxies" { class: gateway }
  agent: "Local SPIRE Agent on each host\nWorkload API access: realm-proxies group\nIssues identity by systemd unit + Unix user" { class: node }
  caddy -> clients: "Declared upstream socket"
  egress -> clients: "Socket activation"
  clients -> receivers: "Mutual TLS\nSame host or across hosts"
  receivers -> ingress: "Private TCP backend path"
  clients -> native: "Mutual TLS"
  clients -> agent: "Certificates" { style.stroke-dash: 5 }
  receivers -> agent: "Certificates" { style.stroke-dash: 5 }
  native -> agent: "Certificates" { style.stroke-dash: 5 }
}

backend_ns: "Workload B: separate private network namespace\nHeld by realm-net-<backend>.service / Loopback only" {
  class: namespace
  adapter: "TCP backend adapter\nUser / Group: realm-<backend>\nJoins the backend network namespace" { class: gateway }
  backend: "Private backend\nUser: <backend user> / Group: <backend group>\nLoopback TCP or declared Unix socket" { class: node }
  adapter -> backend: "Loopback TCP"
}
server: "SPIRE Server on eihort" { class: node }

users -> host_ns.caddy: "HTTPS"
app_ns.app -> host_ns.egress: "Direct Unix socket"
app_ns.adapter -> host_ns.egress: "Unix socket"
host_ns.ingress -> backend_ns.adapter: "Socket activation"
host_ns.receivers -> backend_ns.backend: "Unix backend: direct declared socket\ningressGroups grant filesystem access"
host_ns.agent -> server: "Identity control" { style.stroke-dash: 5 }

note: "Each app and its TCP adapters share one ns. Ghostunnel stays outside it.\nUnix sockets cross ns boundaries through declared mounts and group permissions.\nUnix groups control local socket access. allow.groups expands to SPIFFE identity allowlists.\nSolid links: request paths. Dashed links: identity control.\nContainers use their own ns and mounted sockets instead of joining realm-net-<name>." { class: note }
# Invisible edges arrange the title and note.
title -> users: { style.opacity: 0 }
title -> app_ns: { style.opacity: 0 }
backend_ns -> note: { style.opacity: 0 }
server -> note: { style.opacity: 0 }
